# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Lets managers create logins from Users -> New User. Supabase
# calls it the "secret" or "service_role" key. Never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional. Only needed when the request host is not the public URL
# (e.g. behind a proxy that rewrites Host). Used to build email links.
# NEXT_PUBLIC_SITE_URL=https://your-app.example.com
